{
  "manifestVersion": 5,
  "id": "com.antigravity.vectortracer",
  "name": "VectorTracer Pro",
  "version": "1.0.0",
  "main": "index.html",
  "host": [
    {
      "app": "ILST",
      "minVersion": "27.0.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "vectorTracerPanel",
      "label": {
        "default": "VectorTracer Pro"
      },
      "minimumSize": {
        "width": 280,
        "height": 420
      },
      "maximumSize": {
        "width": 500,
        "height": 800
      },
      "preferredDockedSize": {
        "width": 300,
        "height": 500
      }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "launchProcess": {
      "schemes": ["https", "http"]
    }
  }
}
